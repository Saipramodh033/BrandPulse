# ==================================================================
# BrandPulse Environment Configuration Template
# ==================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (same directory)
# 2. Replace placeholder values with your actual credentials
# 3. NEVER commit the .env file to Git
# ==================================================================

# ------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------
# PostgreSQL connection details for the unified data store
POSTGRES_DB=brandpulse
POSTGRES_USER=brandpulse_user
POSTGRES_PASSWORD=change_me_in_production

# Full connection URL (used by SQLAlchemy)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://brandpulse_user:change_me_in_production@postgres:5432/brandpulse

# ------------------------------------------------------------------
# Google AI API
# ------------------------------------------------------------------
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: Gemini LLM reasoning + text embeddings
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------------
# SendGrid Email Service
# ------------------------------------------------------------------
# Get your API key from: https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@brandpulse.com

# ------------------------------------------------------------------
# Admin Authentication
# ------------------------------------------------------------------
# Dashboard login credentials (bcrypt hashed on first login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# ------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------
# Scheduler check interval (seconds) - how often worker polls for jobs
# 300 = 5 minutes, 3600 = 1 hour, 14400 = 4 hours
SCHEDULER_CHECK_INTERVAL=300

# Maximum PDF file size for company uploads (MB)
MAX_PDF_SIZE_MB=10

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ------------------------------------------------------------------
# Optional: Advanced Configuration
# ------------------------------------------------------------------
# Uncomment if needed for production

# Agent behavior
# MAX_SEARCH_RESULTS=5
# RAG_TOP_K=3
# AGENT_MAX_ITERATIONS=10

# Email templates
# EMAIL_TEMPLATE_PATH=templates/insight_email.html

# Database pooling
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10